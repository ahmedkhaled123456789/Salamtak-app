# CareFlow mobile — public configuration only. Never put database, Redis,
# payment-provider or other backend secrets here: everything prefixed
# EXPO_PUBLIC_ is embedded in the app bundle and readable by anyone.

# Origin of care-backend (without /api/v1).
#   Leave empty in development: the app derives it from the Expo dev-server host
#   (physical device on the same Wi-Fi) or uses http://10.0.2.2:5050 (Android emulator).
#   Set it for staging/production, e.g. https://api.example.com
EXPO_PUBLIC_API_BASE_URL=

# Port used by the dev-host derivation above (care-backend/.env PORT).
EXPO_PUBLIC_API_DEV_PORT=5050

# Offset of the backend's platform timezone (platform.timezone, default Asia/Dubai).
EXPO_PUBLIC_PLATFORM_UTC_OFFSET=+04:00
